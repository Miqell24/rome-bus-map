{
  "name": "rome-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Rome public transport (Atac and provincial buses, metro A/B/B1/C) — Roma Servizi per la Mobilità GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=12288 pipeline/build.mjs --all --tram all",
    "lines": "node --max-old-space-size=12288 pipeline/lines.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "audit": "node --max-old-space-size=12288 pipeline/audit.mjs",
    "serve": "node pipeline/serve.mjs 8169"
  }
}
